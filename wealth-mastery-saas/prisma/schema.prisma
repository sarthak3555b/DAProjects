// ============================================================
// Wealth Mastery OS — PostgreSQL schema (Prisma)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth / Users ----------
enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  settings      Settings?
  progress      UserProgress[]
  studySessions StudySession[]
  journal       JournalEntry[]
  goals         Goal[]
  achievements  UserAchievement[]
  bookmarks     Bookmark[]
  notes         Note[]
  notifications Notification[]
  recommendations Recommendation[]
  mentorMessages MentorMessage[]
  newsState     UserNewsState[]
  resourceState UserResourceState[]
  projectState  UserProjectState[]
  auditLogs     AuditLog[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String?  @db.Text
  startedAt DateTime @default(now())
  timezone  String   @default("Asia/Kolkata")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Settings {
  id            String  @id @default(cuid())
  userId        String  @unique
  reducedMotion Boolean @default(false)
  notifications Boolean @default(true)
  aiEnabled     Boolean @default(false)
  aiProvider    String  @default("local")
  aiModel       String?
  weeklyGoalMin Int     @default(240)
  monthlyGoalMin Int    @default(960)
  yearlyGoalMin Int     @default(11520)
  booksCompleted Int    @default(0)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Curriculum (content) ----------
model Phase {
  id        String   @id @default(cuid())
  code      String   @unique
  title     String
  subtitle  String?
  blurb     String?  @db.Text
  color     String   @default("#3b82f6")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules   Module[]
  projects  Project[]

  @@index([order])
}

model Module {
  id      String  @id @default(cuid())
  phaseId String
  name    String
  order   Int     @default(0)
  phase   Phase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  nodes   Node[]

  @@index([phaseId, order])
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
  MASTER
}

model Node {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  moduleId      String
  order         Int        @default(0)
  description   String?    @db.Text
  purpose       String?    @db.Text
  whyItMatters  String?    @db.Text
  outcomes      String[]
  tags          String[]
  hours         Float      @default(3)
  difficulty    Difficulty @default(BEGINNER)
  exercises     String[]
  reflection    String[]
  realLife      String[]
  careers       String[]
  mastery       String[]
  assignments   Json?
  assessment    Json?
  resources     Json?
  version       Json?
  published     Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  module        Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  prerequisites Dependency[] @relation("Dependent")
  dependents    Dependency[] @relation("Prerequisite")
  progress      UserProgress[]
  bookmarks     Bookmark[]
  notes         Note[]

  @@index([moduleId, order])
  @@index([difficulty])
}

model Dependency {
  id             String @id @default(cuid())
  // prerequisite -> dependent
  prerequisiteId String
  dependentId    String
  prerequisite   Node   @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  dependent      Node   @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)

  @@unique([prerequisiteId, dependentId])
  @@index([dependentId])
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  source    String?
  type      String   @default("Article")
  phaseCode String?
  url       String
  note      String?  @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  state     UserResourceState[]

  @@index([type])
  @@index([phaseCode])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  phaseId   String?
  phaseCode String?
  summary   String?  @db.Text
  order     Int      @default(0)
  phase     Phase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  state     UserProjectState[]

  @@index([phaseCode])
}

model Career {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  emoji       String?
  color       String   @default("#3b82f6")
  description String?  @db.Text
  skills      String[]
  phases      String[]
  projects    String[]
  salary      String?
  aiImpact    String?  @db.Text
  future      String?  @db.Text
  order       Int      @default(0)
}

model NewsItem {
  id        String   @id @default(cuid())
  category  String
  title     String
  date      DateTime @default(now())
  what      String?  @db.Text
  why       String?  @db.Text
  matters   String?  @db.Text
  wealth    String?  @db.Text
  tags      String[]
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  state     UserNewsState[]

  @@index([category])
  @@index([date])
}

// ---------- User state / progress ----------
enum ProgressStatus {
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  nodeId      String
  status      ProgressStatus @default(IN_PROGRESS)
  checklist   Json?
  quizPassed  Boolean        @default(false)
  completedAt DateTime?
  reviewDue   DateTime?
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  node        Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId, status])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  minutes   Int
  day       String   // YYYY-MM-DD for fast heatmap/streak queries
  note      String?
  nodeId    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String
  learned   String?  @db.Text
  confused  String?  @db.Text
  built     String?  @db.Text
  observed  String?  @db.Text
  apply     String?  @db.Text
  questions String?  @db.Text
  body      String?  @db.Text
  tags      String[]
  minutes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

model Goal {
  id         String     @id @default(cuid())
  userId     String
  period     GoalPeriod
  targetMin  Int
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}

model Achievement {
  id     String @id @default(cuid())
  code   String @unique
  emoji  String
  name   String
  desc   String
  users  UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  nodeId    String
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  nodeId    String
  body      String   @db.Text
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
}

model UserNewsState {
  id         String   @id @default(cuid())
  userId     String
  newsId     String
  read       Boolean  @default(false)
  bookmarked Boolean  @default(false)
  note       String?  @db.Text
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  news       NewsItem @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
}

model UserResourceState {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  completed  Boolean  @default(false)
  bookmarked Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
}

model UserProjectState {
  id          String    @id @default(cuid())
  userId      String
  projectId   String
  done        Boolean   @default(false)
  notes       String?   @db.Text
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  title     String
  ref       String?
  route     String?
  createdAt DateTime @default(now())
  dismissed Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dismissed])
}

model MentorMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String   // 'user' | 'assistant'
  text      String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  icon      String?
  text      String
  route     String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity])
  @@index([createdAt])
}
