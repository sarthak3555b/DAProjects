# ============================================================
# Wealth Mastery OS — Environment variables
# Copy to .env (local) or set in Vercel Project Settings.
# ============================================================

# --- Database (required) ---
# Neon Postgres connection string. The Vercel<>Neon integration sets this automatically.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Optional direct (non-pooled) URL for migrations on Neon:
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth (required) ---
# Generate with: openssl rand -base64 32  (Vercel can auto-generate this)
AUTH_SECRET="replace-with-a-long-random-string"
# Public base URL of the deployment (Vercel sets this automatically in prod)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- One-time database seed protection (required) ---
# Visit /api/seed?secret=THIS_VALUE once after first deploy to load all content.
SEED_SECRET="change-me-to-a-random-value"

# --- Optional: Google OAuth (leave blank to disable the Google button) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional: GitHub OAuth ---
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Optional: Email (password reset & verification). Leave blank to print links to server logs instead. ---
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Wealth Mastery OS <noreply@example.com>"

# --- Optional: AI Mentor providers (built-in offline mentor works without these) ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Optional: Sentry monitoring ---
NEXT_PUBLIC_SENTRY_DSN=""

# --- Admin bootstrap: first user with this email is auto-granted ADMIN role on register ---
ADMIN_EMAIL=""
